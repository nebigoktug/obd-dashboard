<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11 ve altı için eski BT izinleri -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android 12+ : eşleşmiş cihazlara bağlanmak için -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- BLE adaptör taraması; konum için kullanılmaz -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Wi-Fi adaptörü: soketi internetsiz Wi-Fi ağına bağlamak için ağları listelemek -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- OBD yokken hız GPS'ten; ileride hava durumu için konum -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ekran kapalıyken CPU uyumasın, veri akışı kesilmesin -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Wi-Fi adaptörüyle Bluetooth'suz da çalışır -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Android 11+ paket görünürlüğü: medya uygulamasının adını ve başlatıcısını bulmak, sesli yönlendirme (TTS) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="OBD Dashboard ESP32"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault.Light.DarkActionBar">

        <!-- Bağlantı ve OBD araçları: dashboard ayarlarından açılır -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="Bağlantı"
            android:launchMode="singleTask" />

        <!-- Araç ekranı (HEADUNIT.md): uygulama doğrudan bununla açılır, yalnız yatay -->
        <activity
            android:name=".dash.DashboardActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".dash.SettingsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Öğrenme modu (Geliştirici, ESP32 kutusu) -->
        <activity
            android:name=".dash.LearnActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Hedef arama (navigasyon, Ev/İş) -->
        <activity
            android:name=".dash.PlaceSearchActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize|stateVisible"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Arıza kodları (Detay sekmesinden) -->
        <activity
            android:name=".dash.DtcActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- İlk açılış sihirbazı -->
        <activity
            android:name=".dash.SetupActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Kayıtları paylaşmak için (yalnız cache/share, yalnız okuma) -->
        <provider
            android:name=".dash.ShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Çalan müziğin oturumlarını okumak için (kullanıcı "bildirim erişimi" verir); bildirim içeriği okunmaz -->
        <service
            android:name=".NaviListener"
            android:exported="true"
            android:label="OBD Dashboard müzik kontrolü"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
